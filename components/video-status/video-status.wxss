.video-state-row{display:flex;gap:19.23rpx;margin:0 0 10rpx;}.video-state-tile{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx;padding:19.23rpx;background:#E8FAEF;border-radius:23.08rpx;}.video-state-title{font-size:21.15rpx;color:#1B2620;font-weight:500;line-height:30.67rpx;}.video-state-label{font-size:19.23rpx;color:#16854A;line-height:27.88rpx;word-break:break-all;}.video-state-track{height:5.77rpx;background:#D5EFDC;border-radius:6rpx;overflow:hidden;}.video-state-fill{height:100%;background:#16854A;border-radius:6rpx;transition:width .2s;}.video-state-retry{font-size:19.23rpx;color:#16854A;line-height:28rpx;}.video-modal-mask{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;background:rgba(27,38,32,.36);}.video-modal{box-sizing:border-box;width:600rpx;max-width:86vw;display:flex;flex-direction:column;gap:26.92rpx;padding:46.15rpx;border-radius:46.15rpx;background:#fff;}.video-modal-title{font-size:34.62rpx;font-weight:700;color:#1B2620;line-height:50.19rpx;}.video-modal-content{font-size:25rpx;line-height:37.5rpx;color:#79817D;white-space:pre-wrap;}.video-modal-confirm{display:flex;align-items:center;justify-content:center;min-height:80.77rpx;border-radius:40.38rpx;background:#B8F76A;color:#1B2620;font-size:26.92rpx;font-weight:500;}.video-modal-later{font-size:25rpx;color:#79817D;text-align:center;line-height:38rpx;}
.video-state-loading,.video-state-result{margin:0 38.46rpx 23.08rpx;}
