page{background:#EFF3F7;color:#20212C;height:100%;}button::after{border:none;}.r-page{height:100vh;display:flex;flex-direction:column;background:linear-gradient(140deg,#FAF3FF 0%,#EFF3F7 52%,#D9FFF2 100%);overflow:hidden;}.r-nav{display:flex;align-items:center;padding-left:32rpx;gap:26rpx;flex-shrink:0;font-size:34rpx;font-weight:700;box-sizing:border-box;}.r-back{font-size:58rpx;color:#727686;width:38rpx;line-height:64rpx;font-weight:400;}.r-scroll{flex:1;min-height:0;height:0;width:100%;}.r-content{display:flex;flex-direction:column;padding:24rpx 38rpx calc(24rpx + env(safe-area-inset-bottom));gap:24rpx;}.r-hero{background:linear-gradient(120deg,#EEE4FF,#DEFFF3);border-radius:46rpx;padding:26rpx 38rpx;display:flex;flex-direction:column;gap:10rpx;}.r-eyebrow{font-size:26rpx;color:#727686;}.r-reward{display:flex;align-items:baseline;gap:16rpx;color:#8273FA;font-size:24rpx;}.r-number{font-size:68rpx;line-height:78rpx;font-weight:800;}.r-sub{font-size:21rpx;line-height:32rpx;color:#727686;}.r-card{background:#FFF;border-radius:46rpx;padding:30rpx 38rpx;}.r-code-card{display:flex;flex-direction:column;gap:22rpx;}.r-label{font-size:24rpx;color:#727686;}.r-code-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;}.r-code{font-size:41rpx;line-height:58rpx;font-weight:700;letter-spacing:2rpx;min-width:0;}.r-copy{font-size:25rpx;color:#8273FA;padding:10rpx 0 10rpx 16rpx;flex-shrink:0;}.r-actions{display:flex;gap:18rpx;}.r-button{flex:1;min-width:0;height:84rpx;margin:0;border-radius:44rpx;padding:0;font-size:26rpx;font-weight:600;line-height:84rpx;}.r-primary{background:#8273FA;color:#FFF;}.r-soft{background:#F0EDFF;color:#8273FA;}.r-button[disabled]{opacity:.5;color:#727686;background:#F0EDFF;}.r-stats{display:flex;align-items:center;justify-content:space-around;padding-top:25rpx;padding-bottom:25rpx;}.r-stat{display:flex;flex-direction:column;align-items:center;gap:8rpx;min-width:0;}.r-total{font-size:48rpx;line-height:58rpx;font-weight:700;color:#8273FA;}.r-stat-line{width:2rpx;height:62rpx;background:#EDF0F5;}.r-rules{display:flex;flex-direction:column;gap:14rpx;font-size:22rpx;line-height:32rpx;color:#727686;}.r-title{font-size:28rpx;color:#20212C;font-weight:700;margin-bottom:4rpx;}.r-footnote{text-align:center;font-size:21rpx;color:#8D91A0;line-height:30rpx;}.r-error{font-size:21rpx;color:#B35061;line-height:32rpx;}.r-canvas{position:fixed;width:1px;height:1px;left:-2000px;top:-2000px;pointer-events:none;}
