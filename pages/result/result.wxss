/* 对应 Figma「全界面 · 鲜绿统一」，尺寸按 390px → 750rpx 换算。 */
.x-scroll {
  width:100%;
  height:0;
  min-height:0;
  flex:1 1 0;
  padding-bottom:32rpx;
}

.x-statusbar {
  width:100%;
  flex-shrink:0;
}

.x-nav {
  height:104rpx;
  display:flex;
  align-items:center;
  padding:0 38rpx;
  gap:18rpx;
  padding-right:var(--nav-safe-r,196rpx);
  position:relative;
}

.x-nav-title {
  font-size:36rpx;
  line-height:1.4;
  font-weight:700;
  min-width:0;
  white-space:nowrap;
}

.x-nav-btn,.x-nav-back {
  min-width:40rpx;
  height:72rpx;
  display:flex;
  align-items:center;
  font-size:52rpx;
  color:#79817D;
}

.x-nav-action {
  font-size:23rpx;
  color:#16854A;
  white-space:nowrap;
  margin-left:auto;
}

.x-card {
  width:calc(100% - 76rpx);
  margin:24rpx 38rpx 0;
  padding:32rpx;
  background:#FFFFFF;
  border-radius:44rpx;
  box-shadow:none;
  border:0;
}

.x-cardhead {
  align-items:center;
  min-height:38rpx;
  gap:12rpx;
}

.x-cardhead-t {
  font-size:31rpx;
  line-height:1.4;
font-weight:700
}

.x-cardhead-more {
  font-size:23rpx;
color:#A1AAA4
}

.x-chevron {
  font-size:40rpx;
  line-height:1;
  color:#A1AAA4;
margin-left:12rpx
}

.x-empty {
  font-size:26rpx;
  line-height:1.6;
  color:#79817D;
  padding:30rpx 0;
text-align:center
}

.x-udivider {
  height:1rpx;
  background:#E8EEEA;
  width:100%;
margin:28rpx 0
}

.text-wrapper_26,.text-wrapper_20,.text-wrapper_15 {
  height:104rpx;
  padding:0 38rpx;
  padding-right:var(--nav-safe-r,196rpx);
  align-items:center;
  gap:18rpx;
}

.text_3 {
  font-size:52rpx;
  color:#79817D;
  line-height:72rpx;
min-width:40rpx
}

.text_4 {
  font-size:36rpx;
  font-weight:700;
  color:#1B2620;
  white-space:nowrap;
line-height:1.4
}

.text_5 {
  font-size:23rpx;
  color:#16854A;
  white-space:nowrap;
  margin-left:auto;
}

.group_1 {
  width:calc(100% - 76rpx);
  margin-left:38rpx;
  margin-right:38rpx;
  border-radius:44rpx;
  margin-top:20rpx;
  padding:26rpx;
  background:white;
  align-items:center;
gap:20rpx
}

.x-thumb,.x-thumb-media {
  width:94rpx;
  height:94rpx;
  background:#E8FAEF;
  border-radius:24rpx;
overflow:hidden
}

.x-thumb {
  align-items:center;
justify-content:center
}

.text_6 {
  font-size:29rpx;
color:#16854A
}

.group_10 {
  flex:1 1 0;
min-width:0
}

.text-group_9 {
gap:8rpx
}

.text_7 {
  font-size:28rpx;
  font-weight:700;
  line-height:1.5;
  overflow:hidden;
  text-overflow:ellipsis;
white-space:nowrap
}

.text_8 {
  font-size:23rpx;
  line-height:1.6;
  color:#79817D;
}

.group_3 {
  width:calc(100% - 76rpx);
  margin-left:38rpx;
  margin-right:38rpx;
  border-radius:44rpx;
  margin-top:24rpx;
  padding:8rpx;
  background:#E8EEEA;
  gap:8rpx;
min-height:84rpx
}

.text-wrapper_5 {
  flex:1 1 0;
  min-width:0;
  min-height:68rpx;
  background:white;
border-radius:24rpx
}

.text_10,.text_11 {
  font-size:26rpx;
  font-weight:700;
color:#16854A
}

.x-seg-off {
background:transparent
}

.x-seg-off .text_10,.x-seg-off .text_11 {
  color:#79817D;
font-weight:400
}

.text_12 {
  font-size:31rpx;
  line-height:1.4;
  font-weight:700;
  color:#1B2620;
margin:30rpx 38rpx 20rpx
}

.box_2 {
  width:calc(100% - 76rpx);
  margin-left:38rpx;
  margin-right:38rpx;
  border-radius:44rpx;
  margin-top:18rpx;
  padding:28rpx;
  background:#E8FAEF;
  gap:18rpx;
  align-items:stretch;
justify-content:flex-start
}

.section_1 {
  width:6rpx;
  min-height:70rpx;
  background:#B8F76A;
border-radius:6rpx
}

.text_13 {
  flex:1 1 0;
  min-width:0;
  font-size:31rpx;
  font-weight:700;
  line-height:1.65;
color:#16854A
}

.text_14 {
  font-size:23rpx;
  line-height:1.6;
  color:#79817D;
margin:20rpx 38rpx 4rpx
}

.list_3 {
  width:calc(100% - 76rpx);
  margin-left:38rpx;
  margin-right:38rpx;
  border-radius:44rpx;
  margin-top:24rpx;
  padding:8rpx 30rpx;
background:white
}

.group_5-0 {
  padding:24rpx 0;
gap:12rpx
}

.group_5-0+.group_5-0 {
border-top:1rpx solid #E8EEEA
}

.text_15-0 {
  font-size:31rpx;
  font-weight:700;
  color:#1B2620;
line-height:1.5
}

.paragraph_1-0,.x-para {
  font-size:30rpx;
  line-height:1.8;
  color:#79817D;
word-break:break-word
}

.x-para {
  width:calc(100% - 76rpx);
  margin-left:38rpx;
  margin-right:38rpx;
  border-radius:44rpx;
  padding:30rpx;
  background:white;
margin-top:20rpx
}

.x-raw-meta,.x-raw-empty,.x-empty,.x-editor-hint {
  font-size:23rpx;
  line-height:1.6;
  color:#79817D;
margin:24rpx 38rpx
}

.x-editor-area {
  width:calc(100% - 76rpx);
  margin-left:38rpx;
  margin-right:38rpx;
  border-radius:44rpx;
  padding:30rpx;
  background:white;
  min-height:500rpx;
  font-size:30rpx;
line-height:1.8
}

.group_7 {
  padding:20rpx 38rpx calc(24rpx + env(safe-area-inset-bottom));
  background:white;
  gap:18rpx;
border-radius:40rpx 40rpx 0 0
}

.text-wrapper_6 {
  flex:1 1 0;
  min-width:0;
  background:#E8FAEF;
  border-radius:28rpx;
min-height:96rpx
}

.text_18 {
  font-size:26rpx;
  color:#16854A;
font-weight:700
}

.text-wrapper_7 {
  flex:1.7 1 0;
  min-width:0;
  background:#B8F76A;
  border-radius:28rpx;
  min-height:96rpx;
  align-items:center;
  justify-content:center;
gap:14rpx
}

.text_19,.text_20 {
  font-size:27rpx;
  font-weight:700;
color:white
}


/* 与首页共用轻阴影；激活状态只改变颜色，布局尺寸保持固定。 */
.group_1,.box_2,.list_3,.x-para,.x-editor-area{box-shadow:var(--card-shadow);}
.text_19,.text_20{color:#1B2620;}
.section_1{background:#B8F76A;}

.suite-copy-icon{position:relative;width:27rpx;height:30rpx;flex-shrink:0;margin-left:3rpx;}
.suite-copy-icon::before,.suite-copy-icon::after{content:"";position:absolute;width:20rpx;height:23rpx;border:2rpx solid #1B2620;border-radius:4rpx;}
.suite-copy-icon::before{left:0;top:0;background:#B8F76A;}
.suite-copy-icon::after{right:0;bottom:0;background:#B8F76A;}
