/* 对应 Figma「全界面 · 淡彩焕新」，尺寸按 390px → 750rpx 换算。 */
.x-scroll {
  width:100%;
  height:0;
  min-height:0;
  flex:1 1 0;
  padding-bottom:32rpx;
}

.x-statusbar {
  width:100%;
  flex-shrink:0;
}

.x-nav {
  height:104rpx;
  display:flex;
  align-items:center;
  padding:0 38rpx;
  gap:18rpx;
  padding-right:var(--nav-safe-r,196rpx);
  position:relative;
}

.x-nav-title {
  font-size:36rpx;
  line-height:1.4;
  font-weight:700;
  min-width:0;
  white-space:nowrap;
}

.x-nav-btn,.x-nav-back {
  min-width:40rpx;
  height:72rpx;
  display:flex;
  align-items:center;
  font-size:52rpx;
  color:#727686;
}

.x-nav-action {
  font-size:23rpx;
  color:#8273FA;
  white-space:nowrap;
  margin-left:auto;
}

.x-card {
  width:calc(100% - 76rpx);
  margin:24rpx 38rpx 0;
  padding:32rpx;
  background:#FFFFFF;
  border-radius:44rpx;
  box-shadow:none;
  border:0;
}

.x-cardhead {
  align-items:center;
  min-height:38rpx;
  gap:12rpx;
}

.x-cardhead-t {
  font-size:31rpx;
  line-height:1.4;
font-weight:700
}

.x-cardhead-more {
  font-size:23rpx;
color:#A1A5B2
}

.x-chevron {
  font-size:40rpx;
  line-height:1;
  color:#A1A5B2;
margin-left:12rpx
}

.x-empty {
  font-size:26rpx;
  line-height:1.6;
  color:#727686;
  padding:30rpx 0;
text-align:center
}

.x-udivider {
  height:1rpx;
  background:#EDF0F5;
  width:100%;
margin:28rpx 0
}

.x-video {
  width:calc(100% - 76rpx);
  margin-left:38rpx;
  margin-right:38rpx;
  border-radius:44rpx;
  margin-top:20rpx;
  padding:26rpx;
  background:white;
  align-items:center;
gap:22rpx
}

.x-video-thumb,.x-video-thumb-img {
  width:94rpx;
  height:94rpx;
  border-radius:26rpx;
  overflow:hidden;
background:#F0EDFF
}

.x-video-play {
  font-size:29rpx;
color:#8273FA
}

.x-video-info {
  flex:1 1 0;
  min-width:0;
gap:8rpx
}

.x-video-title {
  font-size:28rpx;
  font-weight:700;
  line-height:1.5;
  overflow:hidden;
  text-overflow:ellipsis;
white-space:nowrap
}

.x-video-sub {
  font-size:23rpx;
  line-height:1.6;
  color:#727686;
}

.x-ring-wrap {
  margin-top:44rpx;
width:100%
}

.x-ring,.x-ring-canvas {
  width:300rpx;
height:300rpx
}

.x-ring {
position:relative
}

.x-ring-center {
  position:absolute;
  left:0;
  top:0;
  width:300rpx;
height:300rpx
}

.x-ring-pct {
  font-size:64rpx;
  font-weight:900;
  color:#20212C;
line-height:1.2
}

.x-ring-label {
  font-size:23rpx;
  color:#727686;
margin-top:12rpx
}

.x-state {
  margin-top:30rpx;
  padding:0 38rpx;
  gap:12rpx;
text-align:center
}

.x-state-title {
  font-size:33rpx;
  font-weight:700;
  color:#20212C;
line-height:1.4
}

.x-state-sub {
  font-size:23rpx;
  line-height:1.6;
  color:#727686;
}

.x-steps {
  width:calc(100% - 76rpx);
  margin-left:38rpx;
  margin-right:38rpx;
  border-radius:44rpx;
  margin-top:30rpx;
  margin-bottom:24rpx;
  padding:16rpx 28rpx;
  background:white;
}

.x-step {
  padding:18rpx 0;
  gap:20rpx;
align-items:center
}

.x-step-dot {
  width:48rpx;
  height:48rpx;
  border-radius:18rpx;
background:#EDF0F5
}

.x-step-mark {
  font-size:24rpx;
font-weight:700
}

.x-step-doing {
  background:#8273FA;
color:white
}

.x-step-done {
  background:#D9FFF2;
color:#527769
}

.x-step-body {
  flex:1 1 0;
  min-width:0;
gap:6rpx
}

.x-step-name {
  font-size:27rpx;
  color:#727686;
font-weight:700
}

.x-step-name-doing {
color:#20212C
}

.x-step-name-done {
color:#527769
}

.x-step-status {
  font-size:21rpx;
  color:#A1A5B2;
line-height:1.4
}

.x-footer {
  padding:18rpx 38rpx calc(24rpx + env(safe-area-inset-bottom));
background:#EFF3F7
}

.x-foot-hint {
  font-size:21rpx;
  line-height:1.6;
  color:#727686;
  text-align:center;
margin-bottom:18rpx
}

.x-cancel,.x-back {
  width:100%;
  height:92rpx;
  border-radius:28rpx;
  font-size:29rpx;
  font-weight:700;
line-height:92rpx
}

.x-cancel {
  background:white;
color:#D95C73
}

.x-back {
  margin-top:16rpx;
  background:#8273FA;
color:white
}

.x-nav-btn {
font-size:27rpx
}

.x-cancel,.x-back {
text-align:center
}

