/* 对应 Figma「全界面 · 鲜绿统一」，尺寸按 390px → 750rpx 换算。 */
.x-scroll {
  width:100%;
  height:0;
  min-height:0;
  flex:1 1 0;
  padding-bottom:32rpx;
}

.x-statusbar {
  width:100%;
  flex-shrink:0;
}

.x-nav {
  height:104rpx;
  display:flex;
  align-items:center;
  padding:0 38rpx;
  gap:18rpx;
  padding-right:var(--nav-safe-r,196rpx);
  position:relative;
}

.x-nav-title {
  font-size:36rpx;
  line-height:1.4;
  font-weight:700;
  min-width:0;
  white-space:nowrap;
}

.x-nav-btn,.x-nav-back {
  min-width:40rpx;
  height:72rpx;
  display:flex;
  align-items:center;
  font-size:52rpx;
  color:#79817D;
}

.x-nav-action {
  font-size:23rpx;
  color:#16854A;
  white-space:nowrap;
  margin-left:auto;
}

.x-card {
  width:calc(100% - 76rpx);
  margin:24rpx 38rpx 0;
  padding:32rpx;
  background:#FFFFFF;
  border-radius:44rpx;
  box-shadow:none;
  border:0;
}

.x-cardhead {
  align-items:center;
  min-height:38rpx;
  gap:12rpx;
}

.x-cardhead-t {
  font-size:31rpx;
  line-height:1.4;
font-weight:700
}

.x-cardhead-more {
  font-size:23rpx;
color:#A1AAA4
}

.x-chevron {
  font-size:40rpx;
  line-height:1;
  color:#A1AAA4;
margin-left:12rpx
}

.x-empty {
  font-size:26rpx;
  line-height:1.6;
  color:#79817D;
  padding:30rpx 0;
text-align:center
}

.x-udivider {
  height:1rpx;
  background:#E8EEEA;
  width:100%;
margin:28rpx 0
}

.group_10 {
  flex-direction:column;
  flex:1 1 0;
  min-height:0;
width:100%
}

.box_9 {
  height:0;
  flex:1 1 0;
  width:100%;
padding-bottom:32rpx
}

.text-wrapper_30 {
  height:104rpx;
  padding:0 38rpx;
  align-items:center;
  gap:18rpx;
padding-right:var(--nav-safe-r,196rpx)
}

.text_3 {
  font-size:36rpx;
  font-weight:800;
white-space:nowrap
}

.text_4 {
  font-size:22rpx;
  color:#79817D;
white-space:nowrap
}

.text-wrapper_3 {
  width:calc(100% - 76rpx);
  margin-left:38rpx;
  margin-right:38rpx;
  border-radius:44rpx;
  margin-top:16rpx;
  padding:18rpx 28rpx;
  min-height:86rpx;
  background:white;
  align-items:center;
gap:14rpx
}

.text_5 {
  font-size:36rpx;
color:#A1AAA4
}

.text_6 {
  font-size:26rpx;
  flex:1 1 0;
  min-width:0;
height:46rpx
}

.box_10 {
  margin:24rpx 38rpx 8rpx;
  gap:14rpx;
flex-wrap:wrap
}

.x-pill {
  padding:12rpx 24rpx;
  background:white;
  border-radius:28rpx;
min-height:60rpx
}

.x-pill-t {
  font-size:23rpx;
color:#79817D
}

.x-pill-on {
background:#B8F76A
}

.x-pill-on .x-pill-t {
  color:white;
font-weight:700
}

.text-wrapper_31 {
  margin:30rpx 38rpx 18rpx;
align-items:center
}

.text_11 {
  font-size:31rpx;
  line-height:1.4;
  font-weight:700;
  color:#1B2620;
}

.text_12 {
  font-size:23rpx;
color:#A1AAA4
}

.box_2 {
  width:calc(100% - 76rpx);
  margin-left:38rpx;
  margin-right:38rpx;
  border-radius:44rpx;
  padding:26rpx;
  background:white;
  margin-top:16rpx;
  gap:22rpx;
  align-items:center;
min-height:164rpx
}

.x-thumb {
  width:116rpx;
  height:116rpx;
  border-radius:28rpx;
  background:#E8FAEF;
  overflow:hidden;
  align-items:center;
justify-content:center
}

.x-thumb-media {
  width:116rpx;
height:116rpx
}

.text_13 {
  font-size:30rpx;
color:#16854A
}

.box_11 {
  flex:1 1 0;
min-width:0
}

.text-group_17 {
  gap:12rpx;
width:100%
}

.text_14 {
  font-size:27rpx;
  font-weight:700;
  line-height:1.5;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
overflow:hidden
}

.x-metaline {
  gap:6rpx;
  align-items:center;
flex-wrap:wrap
}

.text_15 {
  font-size:21rpx;
  line-height:1.5;
  color:#79817D;
  min-width:0;
max-width:100%
}

.x-actions {
  gap:8rpx;
margin-left:auto
}

.x-act {
  width:52rpx;
  height:52rpx;
  border-radius:26rpx;
  background:#F5F7F5;
  font-size:27rpx;
  font-weight:400;
color:#7C9285
}



.x-ico-copy{-webkit-mask-image:url("data:image/png;base64,");mask-image:url("data:image/png;base64,");-webkit-mask-size:contain;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center}

.x-ico-trash{-webkit-mask-image:url("data:image/png;base64,");mask-image:url("data:image/png;base64,");-webkit-mask-size:contain;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center}

.x-tip,.x-empty {
margin:28rpx 38rpx
}

.x-empty {
  background:white;
  border-radius:44rpx;
padding:38rpx 24rpx
}

.x-empty-t {
  font-size:29rpx;
  font-weight:700;
color:#1B2620
}

.x-empty-s {
  font-size:23rpx;
  color:#79817D;
  margin-top:12rpx;
line-height:1.6
}

.box_5 {
  width:calc(100% - 76rpx);
  margin-left:38rpx;
  margin-right:38rpx;
  border-radius:44rpx;
  margin-top:24rpx;
  padding:22rpx;
  background:#E8FAEF;
  gap:12rpx;
align-items:center
}

.group_5 {
  width:14rpx;
  height:14rpx;
  border-radius:50%;
background:#B8F76A
}

.text_30 {
  font-size:22rpx;
  color:#16854A;
  flex:1 1 0;
  min-width:0;
line-height:1.6
}

.section_2 {
  background:white;
  border-radius:44rpx 44rpx 0 0;
padding-bottom:env(safe-area-inset-bottom)
}

.block_6 {
  height:120rpx;
align-items:center
}

.text-group_20,.text-wrapper_34,.text-group_21 {
  flex:1 1 0;
  min-width:0;
  flex-direction:column;
  align-items:center;
  justify-content:center;
gap:8rpx
}

.text_33,.text_35,.text_37 {
  width:44rpx;
height:44rpx
}

.text_34,.text_36,.text_32 {
  font-size:22rpx;
color:#A1AAA4
}

.text_36 {
  color:#16854A;
font-weight:700
}

.x-ico-copy{-webkit-mask-image:url("data:image/png;base64,");mask-image:url("data:image/png;base64,");-webkit-mask-size:contain;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center}

.x-ico-trash{-webkit-mask-image:url("data:image/png;base64,");mask-image:url("data:image/png;base64,");-webkit-mask-size:contain;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center}


/* 与首页共用轻阴影；激活状态只改变颜色，布局尺寸保持固定。 */
.text-wrapper_3,.box_2,.x-empty{box-shadow:var(--card-shadow);}
.x-pill-on .x-pill-t{color:#1B2620;}

/* 次要操作使用灰绿色细线，弱化按钮视觉重量。 */


.x-ico-copy,.x-ico-trash{width:28rpx;height:28rpx;background:#7C9285;mask-size:contain;mask-position:center;mask-repeat:no-repeat;}

.search-feedback{margin:20rpx 38rpx 0;color:#79817D;font-size:23rpx;line-height:1.6}.search-hit{background:#DCFAA9;color:#1F3327;border-radius:6rpx}.search-snippet{font-size:24rpx;line-height:1.65;color:#65736C;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.search-snippet-label{color:#16854A}
