<view class="page flex-col" style="--nav-safe-r:{{navSafeRightRpx}}rpx">
  <view class="group_10 flex-row">
    <view class="text-wrapper_29" style="height:{{statusBarH}}px"></view>
      <view class="text-wrapper_30 flex-row">
        <view class="text_3">文案提取记录</view>
        <view class="text_4">共 {{total}} 条</view>
      </view>
<scroll-view
      class="box_9 flex-col"
      scroll-y
      scroll-top="{{scrollTop}}"
      bindscroll="onHistoryScroll"
      refresher-enabled
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="onReachBottom"
    >
      
      <view class="text-wrapper_3 flex-row">
        <view class="text_5">⌕</view>
        <input
          class="text_6"
          value="{{keyword}}"
          placeholder="搜索标题、金句、来源或文案内容"
          placeholder-class="x-ph"
          confirm-type="search"
          bindinput="onSearch"
          bindconfirm="onSearchConfirm"
        />
      </view>
      <view class="box_10 flex-row">
        <view
          class="x-pill flex-col justify-center align-center x-tap {{activeFilter === item.id ? 'x-pill-on' : ''}}"
          wx:for="{{filters}}"
          wx:for-item="item"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onFilter"
        >
          <view class="x-pill-t">{{item.label}}</view>
        </view>
      </view>
      <view class="search-feedback" wx:if="{{keyword}}">{{searching ? '正在搜索…' : searchError ? '搜索失败，请点键盘搜索重试' : '找到 ' + total + ' 条匹配记录'}}</view>
      <block wx:for="{{groups}}" wx:for-item="g" wx:for-index="gi" wx:key="label">
        <view class="text-wrapper_31 flex-row justify-between">
          <view class="text_11">{{g.label}}</view>
          <view class="text_12">{{g.count}} 条</view>
        </view>
        <view
          class="box_2 flex-row x-tap"
          wx:for="{{g.items}}"
          wx:for-item="it"
          wx:for-index="ii"
          wx:key="_id"
          data-id="{{it._id}}"
          bindtap="openDetail"
          bindlongpress="onLongPress"
        >
          <view
            class="text-wrapper_9 x-thumb flex-col"
            style="{{it.cover || it.videoSrc ? '' : 'background-color:' + it.thumbBg}}"
          >
            <image
              wx:if="{{it.cover && !it.coverFail}}"
              class="x-thumb-media"
              src="{{it.cover}}"
              mode="aspectFill"
              data-id="{{it._id}}"
              binderror="onCoverError"
            />
            <image wx:else class="suite-video-icon" src="/images/home-green/video.png" mode="aspectFit" aria-hidden="true" />
          </view>
          <view class="box_11 flex-col justify-between">
            <view class="text-group_17 flex-col justify-between">
              <view class="text_14"><block wx:if="{{it.titleParts}}"><text wx:for="{{it.titleParts}}" wx:for-item="part" wx:key="index" class="{{part.hit ? 'search-hit' : ''}}">{{part.text}}</text></block><text wx:else>{{it.title}}</text></view>
              <view class="search-snippet" wx:if="{{it.snippet}}"><text class="search-snippet-label">文案匹配 · </text><text wx:for="{{it.snippetParts}}" wx:for-item="part" wx:key="index" class="{{part.hit ? 'search-hit' : ''}}">{{part.text}}</text></view>
              <view class="x-metaline flex-row justify-between">
                <view class="text_15">{{it.meta}}</view>
                <view class="x-actions flex-row">
                  <view
                    class="x-act flex-col justify-center align-center x-tap"
                    data-id="{{it._id}}"
                    catchtap="copyOne"
                  >
                    <view class="x-ico-copy"></view>
                  </view>
                  <view
                    class="x-act flex-col justify-center align-center x-tap"
                    data-id="{{it._id}}"
                    catchtap="deleteOne"
                  >
                    <view class="x-ico-trash"></view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view class="x-tip" wx:if="{{loading && !groups.length}}">正在加载…</view>
      <view class="x-empty" wx:elif="{{!groups.length}}">
        <view class="ui-empty-art"><view class="ui-art"><image class="ui-full" src="/images/suite-green/document.png" mode="aspectFit" aria-hidden="true" /></view></view><view class="x-empty-t">{{keyword ? (searching ? '正在查找匹配内容' : searchError ? '暂时无法搜索' : '没有找到匹配记录') : '还没有提取记录'}}</view>
        <view class="x-empty-s">{{keyword ? '可尝试其他关键词，或切换到全部平台' : '粘贴视频链接或导入本地视频，开始积累素材'}}</view>
      </view>
      <view class="box_5 flex-row">
        <view class="group_5 flex-col"></view>
        <view class="text_30">转发的视频，结果会自动出现在这里</view>
      </view>
    </scroll-view>
    <view class="app-tabbar">
    <view class="app-tabrow">
      <view class="app-tab " bindtap="goHome" hover-class="app-tab-pressed" role="button" aria-label="首页">
        <image class="app-tab-icon" src="/images/tabbar-fun/tab-home-off.png" mode="aspectFit" aria-hidden="true" />
        <text class="app-tab-label">首页</text>
      </view>
      <view class="app-tab app-tab-active"  aria-label="历史，当前页面">
        <image class="app-tab-icon" src="/images/tabbar-fun/tab-history-on.png" mode="aspectFit" aria-hidden="true" />
        <text class="app-tab-label">历史</text>
      </view>
      <view class="app-tab " bindtap="goMine" hover-class="app-tab-pressed" role="button" aria-label="我的">
        <image class="app-tab-icon" src="/images/tabbar-fun/tab-user-off.png" mode="aspectFit" aria-hidden="true" />
        <text class="app-tab-label">我的</text>
      </view>
    </view>
  </view>
  </view>
</view>
