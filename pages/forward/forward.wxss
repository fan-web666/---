/* 与首页共用轻阴影；激活状态只改变颜色，布局尺寸保持固定。 */
.section_1,.section_3,.section_5,.section_7{box-shadow:var(--card-shadow);}
.text_22,.text_23{color:#1B2620;}

/* ===== 视频教程入口（2026-10-12 新增，**超出设计稿**） =====
   ⚠️ 节奏与上方三步卡完全一致：38rpx 左右边距 / 44rpx 圆角 / 白底 / 同款轻阴影，
      只是排在「只需三步」之后、"新人专享"之前 —— 先文字、后视频，符合阅读顺序。 */
.x-video-entry {width:calc(100% - 76rpx);margin:16rpx 38rpx 0;padding:26rpx 28rpx;border-radius:44rpx;background:#FFFFFF;box-shadow:var(--card-shadow);display:flex;align-items:center;gap:22rpx;}
/* 绿色圆角方块 + 纯 CSS 白三角：不额外引图片资源（少一张图就少一份包体） */
.x-video-entry-icon {position:relative;width:70rpx;height:70rpx;border-radius:24rpx;background:#16854A;flex-shrink:0;}
.x-video-entry-icon::after {content:'';position:absolute;left:50%;top:50%;margin-left:-8rpx;margin-top:-15rpx;border-style:solid;border-width:15rpx 0 15rpx 24rpx;border-color:transparent transparent transparent #FFFFFF;}
.x-video-entry-copy {flex:1 1 0;min-width:0;display:flex;flex-direction:column;gap:8rpx;}
.x-video-entry-title {font-size:29rpx;font-weight:700;line-height:1.4;color:#1B2620;}
.x-video-entry-sub {font-size:23rpx;line-height:1.6;color:#79817D;}
.x-video-entry-arrow {font-size:40rpx;line-height:1;color:#A1AAA4;flex-shrink:0;}
/* ⚠️ .x-pressed 是**页面级**类（只在 pages/index/index.wxss 定义过），本页要用需自行声明 */
.x-pressed {opacity:.72;}

