/* 对应 Figma「全界面 · 鲜绿统一」，尺寸按 390px → 750rpx 换算。 */
.x-scroll {
  width:100%;
  height:0;
  min-height:0;
  flex:1 1 0;
  padding-bottom:32rpx;
}

.x-statusbar {
  width:100%;
  flex-shrink:0;
}

.x-nav {
  height:104rpx;
  display:flex;
  align-items:center;
  padding:0 38rpx;
  gap:18rpx;
  padding-right:var(--nav-safe-r,196rpx);
  position:relative;
}

.x-nav-title {
  font-size:36rpx;
  line-height:1.4;
  font-weight:700;
  min-width:0;
  white-space:nowrap;
}

.x-nav-btn,.x-nav-back {
  min-width:40rpx;
  height:72rpx;
  display:flex;
  align-items:center;
  font-size:52rpx;
  color:#79817D;
}

.x-nav-action {
  font-size:23rpx;
  color:#16854A;
  white-space:nowrap;
  margin-left:auto;
}

.x-card {
  width:calc(100% - 76rpx);
  margin:24rpx 38rpx 0;
  padding:32rpx;
  background:#FFFFFF;
  border-radius:44rpx;
  box-shadow:none;
  border:0;
}

.x-cardhead {
  align-items:center;
  min-height:38rpx;
  gap:12rpx;
}

.x-cardhead-t {
  font-size:31rpx;
  line-height:1.4;
font-weight:700
}

.x-cardhead-more {
  font-size:23rpx;
color:#A1AAA4
}

.x-chevron {
  font-size:40rpx;
  line-height:1;
  color:#A1AAA4;
margin-left:12rpx
}

.x-empty {
  font-size:26rpx;
  line-height:1.6;
  color:#79817D;
  padding:30rpx 0;
text-align:center
}

.x-udivider {
  height:1rpx;
  background:#E8EEEA;
  width:100%;
margin:28rpx 0
}

.x-nav-title {
flex:0 1 auto
}

.x-nav-gear {
  width:38rpx;
  height:38rpx;
margin-left:22rpx
}

.x-usercard {
  position: relative;
  overflow: hidden;
  background: #F5FBF5;
  padding: 32rpx;
}
.x-usercard-art {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  object-fit: fill;
  pointer-events: none;
  z-index: 0;
}
.x-usercard > .x-urow,
.x-usercard > .x-udivider,
.x-usercard > .x-stats {
  position: relative;
  z-index: 1;
}
.x-urow {
  width:100%;
gap:22rpx
}

.x-avatar-btn {
  display:flex;
  align-items:center;
  justify-content:center;
  flex:0 0 100rpx;
  box-sizing:border-box;
  padding:0;
  min-width:100rpx;
  width:100rpx;
  height:100rpx;
  min-height:100rpx;
  background:none;
  line-height:1;
  border-radius:50%;
  overflow:hidden;
margin:0
}

.x-avatar-btn::after {
border:0
}

.x-avatar,.x-avatar-img,.x-avatar-def {
  width:100rpx;
  height:100rpx;
  border-radius:50%;
overflow:hidden
}

.x-avatar-img {
  display:block;
  background:#FFFFFF;
}

.x-avatar-def {
background:white
}

.x-avatar-def-ico {
  width:55rpx;
height:55rpx
}

.x-uinfo {
  width:0;
  flex:1 1 0;
  min-width:0;
gap:12rpx
}

.x-uname-row {
gap:10rpx
}

.x-uname {
  flex:0 1 auto;
  min-width:0;
  font-size:35rpx;
  font-weight:800;
  line-height:1.4;
  overflow:hidden;
  text-overflow:ellipsis;
white-space:nowrap
}

.x-nick-edit {
  flex-shrink:0;
  width:25rpx;
height:25rpx
}

.x-vip {
  box-sizing:border-box;
  width: auto;
  min-width:0;
  align-items:flex-start;
  gap:8rpx;
  align-self:flex-start;
  background:rgba(255,255,255,.72);
  border-radius:22rpx;
  padding:7rpx 14rpx;
max-width:100%
}

.x-vip-ico {
  flex-shrink:0;
  margin-top:3rpx;
  width:24rpx;
height:24rpx
}

.x-vip-t {
  flex: 0 1 auto;
  min-width:0;
  word-break:break-all;
  font-size:21rpx;
  color:#16854A;
  line-height:1.5;
white-space:normal
}

.x-stats {
  width:100%;
gap:16rpx
}

.x-stat {
  flex:1 1 0;
  min-width:0;
gap:8rpx
}

.x-stat-c {
text-align:center
}

.x-stat-r {
text-align:right
}

.x-stat-n {
  font-size:38rpx;
  font-weight:800;
  color:#1B2620;
  line-height:1.3;
  overflow:hidden;
  text-overflow:ellipsis;
white-space:nowrap
}

.x-stat-l {
  font-size:21rpx;
color:#79817D
}

.x-cardhead-r {
margin-left:auto
}

.x-rec {
  gap:16rpx;
margin-top:20rpx
}

.x-rec-info {
  flex:1 1 0;
  min-width:0;
gap:8rpx
}

.x-rec-title {
  font-size:27rpx;
  font-weight:700;
  color:#1B2620;
line-height:1.5
}

.x-rec-meta,.x-rec-empty {
  font-size:23rpx;
  color:#79817D;
line-height:1.6
}

.x-rec-empty {
margin-top:16rpx
}

.x-list {
padding:8rpx 28rpx
}

.x-row {
  min-height:98rpx;
  gap:16rpx;
  padding:18rpx 0;
}

.x-row+.x-row {
border-top:1rpx solid #E8EEEA
}

.x-row-ico {
  width:54rpx;
  height:54rpx;
  border-radius:18rpx;
background:#E8FAEF
}

.x-row-ico .x-ico {
  width:30rpx;
height:30rpx
}

.x-row-t {
  font-size:27rpx;
  line-height:1.5;
  flex:1 1 0;
min-width:0
}

.x-row-v {
  font-size:21rpx;
  line-height:1.5;
  color:#79817D;
  max-width:180rpx;
  overflow:hidden;
  text-overflow:ellipsis;
white-space:nowrap
}

.x-tabbar {
  background:white;
  border-radius:44rpx 44rpx 0 0;
  min-height:120rpx;
padding-bottom:env(safe-area-inset-bottom)
}

.x-tab {
  flex:1 1 0;
  min-width:0;
  align-items:center;
  justify-content:center;
  gap:8rpx;
height:120rpx
}

.x-tab-ico {
  width:44rpx;
height:44rpx
}

.x-tab-t {
  font-size:22rpx;
color:#A1AAA4;
font-weight:700
}

/* ⭐ 2026-10-04 修复：切换 tab 时按钮位置/大小抖动。
   根因 = 激活态单独加 `font-weight:700`，粗体字宽 ≠ 常规字宽 →
   列内居中时整体横向重排。修法 = 统一 700 字重，激活态只用颜色区分。 */
.x-tab-t-on {
  color:#16854A
}

.x-wx,.x-modal {
  position:fixed;
  top:0;
  right:0;
  bottom:0;
  left:0;
  z-index:1000;
  display:flex;
  align-items:center;
justify-content:center
}

.x-wx-mask,.x-modal-mask {
  position:absolute;
  top:0;
  right:0;
  bottom:0;
  left:0;
background:rgba(32,33,44,.4)
}

.x-wx-card,.x-modal-card {
  position:relative;
  width:630rpx;
  max-width:84%;
  padding:38rpx;
  border-radius:44rpx;
  background:linear-gradient(125deg,#FFFFFF 0%,#E6FAEF 100%);
gap:24rpx
}

.x-wx-ico {
  width:88rpx;
  height:88rpx;
  background:#E8FAEF;
border-radius:30rpx
}

.x-wx-title,.x-modal-t {
  font-size:34rpx;
  font-weight:700;
  color:#1B2620;
text-align:center
}

.x-wx-desc {
  font-size:24rpx;
  color:#79817D;
line-height:1.6
}

.x-wx-id {
  background:white;
  border:1rpx solid #E8EEEA;
  border-radius:24rpx;
  width:100%;
padding:24rpx
}

.x-wx-id-t {
  font-size:32rpx;
  font-weight:700;
word-break:break-all
}

.x-wx-copy {
  width:100%;
  height:88rpx;
  background:#B8F76A;
  border-radius:24rpx;
  font-size:29rpx;
  font-weight:700;
color:white
}

.x-wx-cancel {
  font-size:27rpx;
  color:#79817D;
padding:8rpx 0
}

.x-nick-input {
  width:100%;
  height:96rpx;
  padding:0 20rpx;
  background:#E8FAEF;
  border-radius:24rpx;
font-size:26rpx
}

.x-modal-btns {
gap:20rpx
}

.x-modal-btn {
  flex:1 1 0;
  height:88rpx;
  line-height:88rpx;
  text-align:center;
  border-radius:24rpx;
font-size:28rpx
}

.x-modal-cancel {
  background:#E8FAEF;
color:#79817D
}

.x-modal-ok {
  background:#B8F76A;
  color:white;
font-weight:700
}

.x-wx-card,.x-modal-card {
background:#FFFFFF
}

.x-wx-card,.x-modal-card {
  width:600rpx;
  padding:46rpx 38rpx;
gap:38rpx
}

.x-wx-title,.x-modal-t {
line-height:1.6
}

/* 与首页共用轻阴影；激活状态只改变颜色，布局尺寸保持固定。 */
.x-card{box-shadow:var(--card-shadow);}
.x-wx-copy,.x-modal-ok{color:#1B2620;}
 .x-avatar-def{background:#E8FAEF;}
