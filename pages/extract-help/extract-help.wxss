/* Figma 145:1588; shared secondary-page navigation and card scale. */
.mode-help-page{display:flex;flex-direction:column;height:100vh;background:linear-gradient(180deg,#D6FFA3 0%,#F4F5F6 30%,#F4F5F6 100%);color:#1B2620;}
.mode-help-status{flex-shrink:0;}
.mode-help-nav{display:flex;align-items:center;height:104rpx;padding:0 var(--nav-safe-r,196rpx) 0 38.46rpx;gap:18rpx;flex-shrink:0;}
.mode-help-back{display:flex;align-items:center;flex:0 0 40rpx;height:72rpx;font-size:52rpx;line-height:1;color:#79817D;}
.mode-help-nav-title{font-size:36rpx;font-weight:700;line-height:1.4;white-space:nowrap;}
.mode-help-scroll{flex:1;height:0;min-height:0;width:100%;}
.mode-help-content{display:flex;flex-direction:column;gap:30.77rpx;padding:24rpx 38.46rpx calc(76.92rpx + env(safe-area-inset-bottom));}
.mode-help-intro{display:flex;flex-direction:column;gap:11.54rpx;}
.mode-help-headline{font-size:44rpx;font-weight:700;line-height:1.4;}
.mode-help-subtitle{font-size:26rpx;line-height:1.6;color:#79817D;}
.mode-help-card{display:flex;flex-direction:column;gap:15.38rpx;background:#fff;border-radius:44rpx;padding:38.46rpx;box-shadow:var(--card-shadow,0 3.85rpx 19.23rpx rgba(27,38,32,.035));}
.mode-help-modes{gap:30.77rpx;}
.mode-help-section{display:flex;flex-direction:column;gap:15.38rpx;}
.mode-help-section-heading{display:flex;align-items:center;gap:15.38rpx;}
.mode-help-title{font-size:31rpx;font-weight:700;color:#1B2620;line-height:1.4;}
.mode-help-default{font-size:21.15rpx;line-height:30.77rpx;font-weight:500;color:#16854A;background:#E8FAEF;border-radius:21.15rpx;padding:5.77rpx 15.38rpx;}
.mode-help-description{font-size:26rpx;line-height:1.6;color:#79817D;white-space:pre-wrap;}
.mode-help-divider{height:1.92rpx;background:#E8EEE5;width:100%;}
.mode-fee-row{display:flex;align-items:center;min-height:92.31rpx;padding:0 15.38rpx;font-size:26rpx;line-height:1.6;font-weight:500;}
.mode-fee-cell{flex:1;min-width:0;text-align:center;white-space:nowrap;}
.mode-fee-duration{flex:1.59375;text-align:left;}
.mode-fee-duration-hint{display:block;font-size:21rpx;line-height:1.5;color:#79817D;}
.mode-fee-header{min-height:61.54rpx;font-size:23rpx;font-weight:400;color:#79817D;background:#F4F5F6;border-radius:15.38rpx;}
.mode-fee-total{color:#16854A;}
.mode-help-note{font-size:23rpx;line-height:1.6;color:#79817D;white-space:pre-wrap;}
.mode-records{background:#E8FAEF;box-shadow:none;}
.mode-help-reminders{display:flex;flex-direction:column;gap:15.38rpx;}
.mode-help-reminder-title{font-size:26.92rpx;font-weight:700;line-height:40.38rpx;color:#1B2620;}
