.friend-help{height:100vh;display:flex;flex-direction:column;background:linear-gradient(180deg,#E6FFD0 0%,#F4F5F6 28%,#F4F5F6 100%);color:#1B2620;}.friend-help-status{flex-shrink:0;}.friend-help-nav{height:104rpx;display:flex;align-items:center;gap:23.08rpx;padding:0 var(--nav-safe-r,196rpx) 0 38.46rpx;font-size:36.54rpx;font-weight:700;flex-shrink:0;white-space:nowrap;}.friend-help-back{width:46.15rpx;height:72rpx;display:flex;align-items:center;font-size:52rpx;font-weight:400;color:#79817D;}.friend-help-scroll{flex:1;height:0;min-height:0;}.friend-help-body{display:flex;flex-direction:column;gap:30.77rpx;padding:30rpx 38.46rpx calc(70rpx + env(safe-area-inset-bottom));}.friend-help-headline{font-size:44.23rpx;font-weight:700;line-height:1.55;}.friend-help-subtitle,.friend-help-description{font-size:26.92rpx;line-height:1.55;color:#79817D;white-space:pre-wrap;}.friend-help-card{display:flex;flex-direction:column;gap:19.23rpx;padding:38.46rpx;background:#fff;border-radius:46.15rpx;}.friend-help-title{font-size:30.77rpx;font-weight:700;line-height:1.55;}.friend-help-soft{background:#E8FAEF;}.friend-help-note{font-size:23.08rpx;line-height:1.55;color:#79817D;}
