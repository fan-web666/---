/* 三个主页面共用导航几何尺寸：激活态只改变颜色和标签字重。 */
.app-tabbar { flex: 0 0 auto; width: 100%; box-sizing: border-box; background: #FFFFFF; border-radius: 44rpx 44rpx 0 0; padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }
.app-tabrow { display: flex; width: 100%; height: 120rpx; padding: 0; margin: 0; align-items: center; }
.app-tab { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1 1 0; width: 0; min-width: 0; height: 120rpx; padding: 0; margin: 0; gap: 8rpx; color: #A1AAA4; box-sizing: border-box; }
.app-tab-icon { display: block; flex: 0 0 44rpx; width: 44rpx; height: 44rpx; margin: 0; padding: 0; background-color: transparent; }
.app-tab-label { display: block; flex: 0 0 32rpx; width: 100rpx; height: 32rpx; line-height: 32rpx; text-align: center; margin: 0; padding: 0; font-size: 22rpx; font-weight: 400; white-space: nowrap; }
.app-tab-active { color: #1B2620; }
.app-tab-active .app-tab-icon { background-color: transparent; }
.app-tab-active .app-tab-label { font-weight: 700; }
.app-tab-pressed { opacity: .72; }

/* 标题下方内容统一上移 10rpx；滚动区扩展，底部导航仍贴底。 */
.x-home > .x-home-scroll,
.page > .x-scroll,
.page > .block_1,
.group_10 > .box_9,
.r-page > .r-scroll {
  margin-top: -10rpx;
}

/* 全界面 · 鲜绿统一：与首页保持一致的颜色、插画和轻阴影。 */
